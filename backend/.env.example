APP_NAME=Agent Orchestrator
PORT=8080
DB_URL=postgresql://postgres:postgres@localhost:5432/agent_orchestrator
# Path where the shared repo mirror + per-run git worktrees are created.
GIT_WORKSPACES_DIR=./.workspaces
# CORS origin for the frontend dev server (SSE endpoints).
CORS_ORIGIN=http://localhost:5173
# 'fake' (default, free) or 'claude' (real Claude Agent SDK, spends real subscription usage).
AGENT_RUNNER_MODE=fake
# Cloned (branch matched to a project's backendFramework) when a project has
# bootstrapFromTemplate=true and its first run's worktree is empty.
TEMPLATE_FRAMEWORKS_REPO_URL=https://github.com/longtk26/template-frameworks
